{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Уроки Python",
  "version": "0.2.0",
  "identifier": "ru.lesson1.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "devUrl": "http://localhost:5173/lessons/pandas-intro",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Уроки Python",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../content/manifest.json": "content/manifest.json",
      "../../content/assets/*": "content/assets/"
    }
  }
}
